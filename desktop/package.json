    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-wasm": "^3.4.1",
    "vitest": "3.2.6",
    "@xveon/shared": "*",
    "react": "^19.2.4",
