{
  "name": "xtrans-demosaic-web",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "rustup target add wasm32-unknown-unknown && npm install && npm run build:wasm",
    "build:wasm": "npm run build:wasm:decoder && npm run build:wasm:encoder && npm run build:wasm:demosaic",
    "build:wasm:decoder": "wasm-pack build ../shared/crates/rawloader-wasm --target web --profile release-small",
    "build:wasm:encoder": "wasm-pack build ../shared/crates/encode --target web --release",
    "build:wasm:demosaic": "wasm-pack build ../shared/crates/demosaic-wasm --target web --release",
    "build:lensfun": "tsx scripts/convert-lensfun-db.ts",
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && npm run build:lensfun && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:opendrt": "python3 ../tests/opendrt/check_shader.py"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slider": "^1.3.6",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "lucide-react": "^0.563.0",
    "onnxruntime-web": "^1.21.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@webgpu/types": "^0.1.69",
    "fast-xml-parser": "^5.3.6",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.13",
    "vite": "^6.0.0",
    "vite-plugin-wasm": "^3.4.1",
    "vitest": "^3.2.6",
    "wasm-pack": "^0.15.0"
  }
}
